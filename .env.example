# Copy this file to .env and fill in your Firebase project's values.
# Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Any private, hard-to-guess string — namespaces this family's data in
# Firestore so it doesn't collide with anyone else's. Make one up, e.g.
# a random word plus a few digits.
VITE_FAMILY_ID=

# Set to "true" to point local `npm run dev` at `firebase emulators:start`
# instead of your real project. Leave unset for normal use.
VITE_USE_FIREBASE_EMULATOR=
